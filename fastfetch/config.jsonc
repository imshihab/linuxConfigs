{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "width": 30,
        // "height": 30,
        "padding": { "bottom": 1 },
    },
    "display": {
        "separator": " ",
        "color": { "keys": "#2563EB" },
    },
    "modules": [
        {
            "type": "custom",
            "format": "{##2563EB}╭───────── Hardware ────────────────────────{#}",
        },
        { "key": "│ 󰌢 PC ", "type": "host", "format": "{5} {1} ({2})" },
        { "key": "│ ├─ 󰍛 ", "type": "cpu", "showPeCoreCount": true },
        { "key": "│ ├─ 󰢮 ", "type": "gpu", "format": "{1} {2} @ {12}" },
        {
            "key": "│ ├─ 󰍹 ",
            "type": "monitor",
            "format": "{1} px @ {2} Hz - {3} mm",
        },
        { "key": "│ ├─ 󰋊 ", "type": "disk", "folders": "/" },
        { "key": "│ ├─ 󰘚 ", "type": "memory" },
        { "key": "│ ╰─ 󰓡 ", "type": "swap" },
        { "type": "custom", "format": "{##2563EB}│{#}" },
        {
            "type": "custom",
            "format": "{##2563EB}├───────── Software ────────────────────────{#}",
        },
        {
            "key": "│ 󰣛 OS ",
            "type": "os",
            "format": "{##22C55E}Dora the FEDORA{#}",
        },
        { "key": "│ ├─  ", "type": "os", "format": "{3}" },
        {
            "key": "│ ├─  ",
            "type": "title",
            "format": "{user-name}",
        },
        {
            "key": "│ ├─ 󰇅 ",
            "type": "title",
            "format": "{host-name}",
        },
        { "key": "│ ├─  ", "type": "kernel" },
        { "key": "│ ├─ 󰧨 ", "type": "de" },
        { "key": "│ ├─  ", "type": "wm" },
        { "key": "│ ├─  ", "type": "terminal" },
        { "key": "│ ├─  ", "type": "shell" },
        { "key": "│ ╰─  ", "type": "colors", "symbol": "circle" },
        { "type": "custom", "format": "{##2563EB}│{#}" },
        {
            "type": "custom",
            "format": "{##2563EB}├───────── Uptime / Age ────────────────────{#}",
        },
        {
            "key": "│ 󰃭    ",
            "type": "command",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        },
        { "key": "│ ╰─ 󰅐 ", "type": "uptime" },
        {
            "type": "custom",
            "format": "{##2563EB}╰───────────────────────────────────────────{#}",
        },
    ],
}
